# Toolchain file for ATmega128 with avr-gcc and avr-libc.
#
#   cmake -B build -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/avr-gcc.cmake ...

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR avr)

set(KVB_TOOLCHAIN_PREFIX "avr-" CACHE STRING "Prefix of the AVR toolchain executables")
set(KVB_AVR_MCU "atmega128" CACHE STRING "AVR device passed to -mmcu")

set(CMAKE_C_COMPILER   ${KVB_TOOLCHAIN_PREFIX}gcc)
set(CMAKE_CXX_COMPILER ${KVB_TOOLCHAIN_PREFIX}g++)
set(CMAKE_ASM_COMPILER ${KVB_TOOLCHAIN_PREFIX}gcc)

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_C_FLAGS_INIT   "-mmcu=${KVB_AVR_MCU}")
set(CMAKE_CXX_FLAGS_INIT "-mmcu=${KVB_AVR_MCU}")
set(CMAKE_ASM_FLAGS_INIT "-mmcu=${KVB_AVR_MCU}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-mmcu=${KVB_AVR_MCU}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
